# サーバー設定
PORT=3000
NODE_ENV=production

# PostgreSQL接続文字列
# 例: postgresql://aerosocial_app:パスワード@localhost:5432/aerosocial
DATABASE_URL=postgresql://aerosocial_app:changeme@localhost:5432/aerosocial

# JWT署名用シークレット（`openssl rand -hex 32` で生成したものに置き換える）
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# フロントエンドのオリジン（CORS許可用、カンマ区切りで複数可）
CORS_ORIGIN=https://your-frontend-domain.example

# アップロード画像の保存先ディレクトリ
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
